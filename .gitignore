__pycache__/
*.py[cod]
.env
.env.*
*.key
*.pem
.DS_Store
Thumbs.db

# Keep raw page payloads and derived local views out of new commits.
# references/originals/ is the versioned, portable original-text backup.
# Files already tracked by earlier commits are unaffected by these patterns.
references/raw-pages*/
references/sources/
references/noon-*/
references/legacy/*.jsonl
references/full-posts.jsonl
references/full-posts.md
references/posts-index.tsv
